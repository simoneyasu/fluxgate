APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=fluxgate=info,tower_http=info
LOG_FORMAT=json

# DynamoDB persistence and bounded optimistic-concurrency retries.
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=fluxgate-rate-limits
BUCKET_TTL_SECONDS=86400
MAX_CONFLICT_RETRIES=32
